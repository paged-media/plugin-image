{
  "name": "@paged-media/image",
  "private": false,
  "version": "0.1.0-canary.4",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./decode-worker": "./src/decode-worker.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "cp ../NOTICE.md ./NOTICE.md && pnpm run build"
  },
  "dependencies": {
    "@paged-media/plugin-api": "0.2.29-canary.0",
    "@paged-media/plugin-sdk": "0.2.29-canary.0"
  },
  "peerDependencies": {
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@paged-media/image-manifest": "workspace:*",
    "@types/node": "20.19.39",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "wasm",
    "manifest.json",
    "panels",
    "NOTICE.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "canary",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./decode-worker": {
        "types": "./dist/decode-worker.d.ts",
        "default": "./dist/decode-worker.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paged-media/plugin-image.git",
    "directory": "glue"
  }
}
